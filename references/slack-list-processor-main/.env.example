# Slack [ENVIRONMENT-SPECIFIC: each environment has its own Slack app]
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# Redis (BullMQ) [ENVIRONMENT-SPECIFIC: each environment has its own Redis]
REDIS_URL=redis://localhost:6379

# Database [ENVIRONMENT-SPECIFIC: each environment has its own RDS]
DATABASE_URL=postgresql://user:password@localhost:5432/list_processor

# BuiltWith [SHARED: same API key across all environments]
BUILTWITH_API_KEY=your-builtwith-api-key

# Apollo.io [SHARED: same API key across all environments]
APOLLO_API_KEY=your-apollo-api-key
APOLLO_WEBHOOK_SECRET=your-webhook-shared-secret

# Wiza.co (Feature 27: Waterfall Enrichment) [SHARED]
WIZA_API_KEY=your-wiza-bearer-token
WIZA_WEBHOOK_SECRET=sha256-hash-of-wiza-api-key

# AI Ark (Feature 27: Waterfall Enrichment) [SHARED]
AI_ARK_API_KEY=your-aiark-x-token
AI_ARK_WEBHOOK_SECRET=your-aiark-webhook-secret

# Anthropic (AI Orchestrator) [SHARED]
ANTHROPIC_API_KEY=your-anthropic-api-key

# S3-Compatible Object Storage
S3_BUCKET=list-processor-files
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_ENDPOINT=http://localhost:9000

# REST API Authentication
API_KEY=your-internal-api-key

# Cost Tracking (per-unit pricing)
BUILTWITH_COST_PER_CREDIT=0.05
APOLLO_COST_PER_CREDIT=0.05
AI_COST_PER_1K_INPUT_TOKENS=0.0008
AI_COST_PER_1K_OUTPUT_TOKENS=0.004

# Waterfall Enrichment Limits (Feature 27)
MAX_CONTACTS_PER_JOB=2000
PROVIDER_TIMEOUT_MS=5000
WEBHOOK_TIMEOUT_MS=300000

# HubSpot OAuth (per-client OAuth integration)
HUBSPOT_OAUTH_CLIENT_ID=your-hubspot-oauth-client-id
HUBSPOT_OAUTH_CLIENT_SECRET=your-hubspot-oauth-client-secret
HUBSPOT_OAUTH_REDIRECT_URI=https://your-domain.com/api/hubspot/oauth/callback

# Autonomous Agents (Feature 31)
AUTONOMOUS_AGENTS_ENABLED=true
GITHUB_PAT=ghp_your-personal-access-token

# Application
NODE_ENV=development
LOG_LEVEL=debug
HTTP_PORT=3000
WEBHOOK_BASE_URL=https://your-domain.com

# Document Management (Feature 2)
# DOC_MAX_FILE_SIZE=1048576
# DOC_MAX_MARKDOWN_SIZE=524288
# DOC_MAX_CONTEXT_CHARS=4000
# DOC_CHANNEL_PATTERN=-docs$|-documents$
