// ---------------------------------------------------------------------------
// Feature 27: Multi-Provider Waterfall Enrichment
// ---------------------------------------------------------------------------

/// Tracks each provider enrichment attempt for cost attribution and debugging.
/// Records every API call to Apollo, Wiza, or AI Ark with request/response details.
model ProviderAttempt {
  id        String        @id @default(uuid()) @db.Uuid
  jobId     String        @map("job_id") @db.Uuid
  contactId String        @map("contact_id") @db.Uuid
  provider  Provider
  dataType  DataType      @map("data_type")
  status    AttemptStatus

  // Request tracking
  requestId       String? @map("request_id") // Provider's request ID for webhook correlation
  requestPayload  Json?   @map("request_payload") @db.JsonB
  responsePayload Json?   @map("response_payload") @db.JsonB

  // Cost tracking
  cost            Float?
  creditsConsumed Int?   @map("credits_consumed")

  // Result tracking
  emailFound String? @map("email_found")
  phoneFound String? @map("phone_found")

  // Error tracking
  errorMessage String? @map("error_message")
  httpStatus   Int?    @map("http_status")

  // Timing
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  durationMs  Int?      @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  job     Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contact JobContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([contactId])
  @@index([provider, dataType])
  @@index([requestId])
  @@map("provider_attempts")
}

/// Tracks webhook deliveries from Wiza and AI Ark for async phone enrichment.
/// Ensures idempotent webhook processing via unique webhookId constraint.
model ProviderWebhook {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  provider  Provider
  requestId String   @map("request_id") // Correlates with ProviderAttempt.requestId
  webhookId String   @unique @map("webhook_id") // Provider's webhook delivery ID

  // Payload
  rawPayload Json    @map("raw_payload") @db.JsonB
  eventType  String? @map("event_type")

  // Status
  status      WebhookStatus
  processedAt DateTime?     @map("processed_at")

  // Retry tracking
  retriesAttempted Int       @default(0) @map("retries_attempted")
  lastRetryAt      DateTime? @map("last_retry_at")

  // Error tracking
  errorMessage String? @map("error_message")

  // Security
  signatureVerified Boolean  @default(false) @map("signature_verified")
  receivedAt        DateTime @default(now()) @map("received_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([provider, requestId])
  @@index([webhookId])
  @@map("provider_webhooks")
}

/// Stores per-provider pricing configuration for cost calculation.
/// Enables runtime pricing updates without code deployment.
model ProviderCost {
  id             String   @id @default(uuid()) @db.Uuid
  provider       Provider
  dataType       DataType @map("data_type")
  costPerUnit    Float    @map("cost_per_unit") // Cost in USD per successful enrichment
  creditsPerUnit Int?     @map("credits_per_unit") // Provider-specific credit consumption

  effectiveDate DateTime  @default(now()) @map("effective_date")
  expiresAt     DateTime? @map("expires_at") // null = current pricing

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([provider, dataType, effectiveDate])
  @@index([provider, dataType])
  @@map("provider_costs")
}

