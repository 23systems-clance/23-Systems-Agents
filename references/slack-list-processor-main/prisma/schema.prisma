/// Per-workspace quality gate configuration.
/// One-to-one with ManagedClient. When absent, global defaults apply.
model QualityGateConfig {
  id                      String   @id @default(uuid()) @db.Uuid
  clientId                String   @unique @map("client_id") @db.Uuid
  rejectPersonalEmails    Boolean  @default(true) @map("reject_personal_emails")
  rejectMissingCompany    Boolean  @default(true) @map("reject_missing_company")
