// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// The central entity representing a processing request initiated by a Slack user.
model Job {
  id                        String             @id @default(uuid()) @db.Uuid
  slackChannelId            String             @map("slack_channel_id")
  slackChannelName          String?            @map("slack_channel_name")
  slackThreadTs             String             @map("slack_thread_ts")
  slackUserId               String             @map("slack_user_id")
  slackTeamId               String             @map("slack_team_id")
  jobType                   JobType            @map("job_type")
  status                    JobStatus          @default(PENDING)
  progress                  Int                @default(0)
  sourceFileName            String?            @map("source_file_name")
  sourceFileUrl             String?            @map("source_file_url")
  sourceFileType            SourceFileType?    @map("source_file_type")
  sourceRowCount            Int?               @map("source_row_count")
  resultFileUrl             String?            @map("result_file_url")
  resultFileName            String?            @map("result_file_name")
  purpose                   ListPurpose?
  isCosell                  Boolean            @default(false) @map("is_cosell")
  cosellProvider            String?            @map("cosell_provider")
  listOwner                 String?            @map("list_owner")
  campaignName              String?            @map("campaign_name")
  additionalContext         String?            @map("additional_context") @db.Text
  enrichInstruction         String?            @map("enrich_instruction") @db.Text
  bullmqJobId               String?            @map("bullmq_job_id")
  parsedIntent              Json?              @map("parsed_intent") @db.JsonB
  errorMessage              String?            @map("error_message") @db.Text
  companiesProcessed        Int                @default(0) @map("companies_processed")
  companiesFailed           Int                @default(0) @map("companies_failed")
  contactsFound             Int                @default(0) @map("contacts_found")
  documentSlugs             String[]           @default([]) @map("document_slugs")
  settingsOverrides         Json?              @map("settings_overrides") @db.JsonB
  sourceInterface           JobSourceInterface @default(TRIGGER) @map("source_interface")
  /// Credit rate snapshot taken at job start for billing consistency.
  /// Contains effective costs per operation type at time of job creation.
  /// Null for legacy jobs or billing-exempt workspaces.
  creditRateSnapshot        Json?              @map("credit_rate_snapshot") @db.JsonB
  /// Quality gate filtering result for this job (total/passed/filtered/breakdown).
  /// Null for jobs created before quality gating or non-applicable job types.
  qualityGateResult         Json?              @map("quality_gate_result") @db.JsonB
  /// Frozen copy of the QualityGateConfig at job submission time (FR-014).
  qualityGateConfigSnapshot Json?              @map("quality_gate_config_snapshot") @db.JsonB
  /// Apollo search cache statistics for this job (Feature 22).
  apolloSearchCacheHits     Int                @default(0) @map("apollo_search_cache_hits")
  apolloSearchCacheMisses   Int                @default(0) @map("apollo_search_cache_misses")
  apolloContactCacheHits    Int                @default(0) @map("apollo_contact_cache_hits")
  apolloContactCacheMisses  Int                @default(0) @map("apollo_contact_cache_misses")
  /// Cache performance counters for domain enrichment cache (Feature 17).
  cacheHits                 Int                @default(0) @map("cache_hits")
  cacheMisses               Int                @default(0) @map("cache_misses")
  forceRefresh              Boolean            @default(false) @map("force_refresh")
  /// Waterfall enrichment mode for multi-provider contact enrichment (Feature 27).
  enrichmentMode            EnrichmentMode?    @map("enrichment_mode")
  /// Array of providers that successfully returned data for this job (Feature 27).
  providersUsed             String[]           @default([]) @map("providers_used")
  /// Total cost across all providers for this job (Feature 27).
  totalCost                 Float              @default(0) @map("total_cost")
  /// Email verification choice: VERIFY / SKIP / null (US6: Findymail).
  emailVerificationChoice   String?            @map("email_verification_choice")
  /// Count of emails verified as valid by Findymail (US6).
  emailsVerified            Int                @default(0) @map("emails_verified")
  /// Count of emails that failed Findymail verification (US6).
  emailsUnverified          Int                @default(0) @map("emails_unverified")
  clientId                  String?            @map("client_id") @db.Uuid
  startedAt                 DateTime?          @map("started_at")
  completedAt               DateTime?          @map("completed_at")
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")

  // Relations
  client              ManagedClient?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  companies           JobCompany[]
  contacts            JobContact[]
  apiUsageLogs        ApiUsageLog[]
  pendingPhoneLookups PendingPhoneLookup[]
  errorLogs           ErrorLog[]
  agentThreadJobs     AgentThreadJob[]
  providerAttempts    ProviderAttempt[] // Feature 27: Waterfall enrichment attempts
  providerWebhooks    ProviderWebhook[] // Feature 27: Webhook deliveries

  @@index([slackChannelId])
  @@index([slackUserId])
  @@index([status])
  @@index([jobType])
  @@index([createdAt])
  @@index([slackTeamId])
  @@index([clientId])
  @@map("jobs")
}

/// A company record within a specific job. Stores enriched technographic data.
model JobCompany {
  id                   String           @id @default(uuid()) @db.Uuid
  jobId                String           @map("job_id") @db.Uuid
  rowIndex             Int              @map("row_index")
  domain               String?
  companyName          String?          @map("company_name")
  resolvedDomain       String?          @map("resolved_domain")
  locationCountry      String?          @map("location_country")
  locationState        String?          @map("location_state")
  locationCity         String?          @map("location_city")
  locationZip          String?          @map("location_zip")
  trafficRank          Int?             @map("traffic_rank")
  telephones           String[]         @default([])
  emails               String[]         @default([])
  socialProfiles       String[]         @default([]) @map("social_profiles")
  metaNames            String[]         @default([]) @map("meta_names")
  vertical             String?
  companyNameFromApi   String?          @map("company_name_from_api")
  salesRevenue         Int?             @map("sales_revenue")
  techSpendUsd         Int?             @map("tech_spend_usd")
  employeeCount        Int?             @map("employee_count")
  productCount         Int?             @map("product_count")
  followers            Int?
  cloudProviderPrimary String?          @map("cloud_provider_primary")
  cloudProvidersAll    String?          @map("cloud_providers_all")
  techSpendTier        TechSpendTier?   @map("tech_spend_tier")
  techSpendScore       Int?             @map("tech_spend_score")
  technologyCount      Int              @default(0) @map("technology_count")
  enterpriseTechCount  Int              @default(0) @map("enterprise_tech_count")
  enrichmentStatus     EnrichmentStatus @default(PENDING) @map("enrichment_status")
  errorMessage         String?          @map("error_message")
  rawBuiltwithResponse Json?            @map("raw_builtwith_response") @db.JsonB
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  // Relations
  job          Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technologies CompanyTechnology[]
  contacts     JobContact[]

  @@unique([jobId, rowIndex])
  @@index([jobId])
  @@index([domain])
  @@index([enrichmentStatus])
  @@map("job_companies")
}

/// Individual technology detected for a company. Stored separately for queryability.
model CompanyTechnology {
  id            String    @id @default(uuid()) @db.Uuid
  jobCompanyId  String    @map("job_company_id") @db.Uuid
  name          String
  tag           String?
  categories    String[]
  firstDetected DateTime? @map("first_detected")
  lastDetected  DateTime? @map("last_detected")
  isEnterprise  Boolean   @default(false) @map("is_enterprise")

  // Relations
  jobCompany JobCompany @relation(fields: [jobCompanyId], references: [id], onDelete: Cascade)

  @@index([jobCompanyId])
  @@index([name])
  @@map("company_technologies")
}

/// A contact (decision maker) found for a company within a job.
model JobContact {
  id                 String                  @id @default(uuid()) @db.Uuid
  jobId              String                  @map("job_id") @db.Uuid
  jobCompanyId       String                  @map("job_company_id") @db.Uuid
  fullName           String?                 @map("full_name")
  firstName          String?                 @map("first_name")
  lastName           String?                 @map("last_name")
  email              String?
  directPhone        String?                 @map("direct_phone")
  businessPhone      String?                 @map("business_phone")
  jobTitle           String?                 @map("job_title")
  personaType        PersonaType             @map("persona_type")
  seniorityLevel     String?                 @map("seniority_level")
  linkedinUrl        String?                 @map("linkedin_url")
  apolloPersonId     String?                 @map("apollo_person_id")
  isDecisionMaker    Boolean                 @default(true) @map("is_decision_maker")
  timezoneUtc        String?                 @map("timezone_utc")
  timezoneLabel      String?                 @map("timezone_label")
  apolloMetadata     Json?                   @map("apollo_metadata")
  enrichmentStatus   ContactEnrichmentStatus @default(PENDING) @map("enrichment_status")
  phoneReceivedAt    DateTime?               @map("phone_received_at")
  /// Provider that found the email (Feature 27: Waterfall enrichment).
  emailSource        Provider?               @map("email_source")
  /// Cost to enrich email via waterfall (Feature 27).
  emailCost          Float?                  @map("email_cost")
  /// Provider that found the phone (Feature 27: Waterfall enrichment).
  phoneSource        Provider?               @map("phone_source")
  /// Cost to enrich phone via waterfall (Feature 27).
  phoneCost          Float?                  @map("phone_cost")
  /// Number of provider enrichment attempts for this contact (Feature 27).
  enrichmentAttempts Int                     @default(0) @map("enrichment_attempts")
  /// Phone enrichment quality gate result: ACCEPTED_STATE / DO_NOT_CALL / UNKNOWN.
  callStatus         CallStatus?             @map("call_status")
  /// DNC scrub API result: NOT_CHECKED / CLEAN / ON_DNC_LIST.
  dncStatus          DncStatus?              @map("dnc_status")
  /// Findymail email verification result (US6).
  emailVerified      Boolean?                @map("email_verified")
  /// Email provider detected by Findymail, e.g. "Google", "Microsoft" (US6).
  emailProvider      String?                 @map("email_provider")
  /// Cost of Findymail verification call for this contact (US6).
  verificationCost   Float?                  @map("verification_cost")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  // Relations
  job                 Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobCompany          JobCompany           @relation(fields: [jobCompanyId], references: [id], onDelete: Cascade)
  pendingPhoneLookups PendingPhoneLookup[]
  providerAttempts    ProviderAttempt[] // Feature 27: Enrichment attempts

  @@index([jobId])
  @@index([jobCompanyId])
  @@index([personaType])
  @@index([enrichmentStatus])
  @@map("job_contacts")
}

/// Correlation table for Apollo.io async phone webhook delivery.
model PendingPhoneLookup {
  id              String            @id @default(uuid()) @db.Uuid
  jobId           String            @map("job_id") @db.Uuid
  jobContactId    String            @map("job_contact_id") @db.Uuid
  apolloRequestId String            @unique @map("apollo_request_id")
  status          PhoneLookupStatus @default(PENDING)
  phoneData       Json?             @map("phone_data") @db.JsonB
  expiresAt       DateTime          @map("expires_at")
  receivedAt      DateTime?         @map("received_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  // Relations
  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobContact JobContact @relation(fields: [jobContactId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@map("pending_phone_lookups")
}

/// Cached technology report results to avoid duplicate API charges (FR-018).
model TechReportCache {
  id                 String   @id @default(uuid()) @db.Uuid
  queryHash          String   @unique @map("query_hash")
  technology         String
  country            String?
  stateRegion        String?  @map("state_region")
  companySize        String?  @map("company_size")
  trafficLevel       String?  @map("traffic_level")
  resultCount        Int      @map("result_count")
  resultFileUrl      String   @map("result_file_url")
  requestedByUserId  String   @map("requested_by_user_id")
  requestedInChannel String   @map("requested_in_channel")
  createdAt          DateTime @default(now()) @map("created_at")

  // Relations
  entries TechReportCacheEntry[]

  @@index([technology])
  @@index([createdAt])
  @@map("tech_report_caches")
}

/// Individual company entry within a cached tech report.
model TechReportCacheEntry {
  id                 String  @id @default(uuid()) @db.Uuid
  cacheId            String  @map("cache_id") @db.Uuid
  domain             String
  companyName        String? @map("company_name")
  country            String?
  stateRegion        String? @map("state_region")
  city               String?
  trafficRank        Int?    @map("traffic_rank")
  technologyDetected String  @map("technology_detected")

  // Relations
  cache TechReportCache @relation(fields: [cacheId], references: [id], onDelete: Cascade)

  @@index([cacheId])
  @@index([domain])
  @@map("tech_report_cache_entries")
}

/// Tracks API usage per job for cost attribution (FR-019).
model ApiUsageLog {
  id               String     @id @default(uuid()) @db.Uuid
  jobId            String     @map("job_id") @db.Uuid
  service          ApiService
  endpoint         String
  requestCount     Int        @default(1) @map("request_count")
  creditsConsumed  Decimal?   @map("credits_consumed")
  tokensInput      Int?       @map("tokens_input")
  tokensOutput     Int?       @map("tokens_output")
  estimatedCostUsd Decimal?   @map("estimated_cost_usd")
  responseStatus   Int?       @map("response_status")
  durationMs       Int?       @map("duration_ms")
  slackTeamId      String?    @map("slack_team_id")
  createdAt        DateTime   @default(now()) @map("created_at")

  // Relations
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([service])
  @@index([createdAt])
  @@index([slackTeamId])
  @@map("api_usage_logs")
}

/// Immutable audit trail for all user-facing actions (Constitution Principle V - SOC 2).
/// Append-only: no UPDATE or DELETE. No updated_at field.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  action      String   @map("action")
  actorUserId String   @map("actor_user_id")
  actorTeamId String?  @map("actor_team_id")
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  channelId   String?  @map("channel_id")
  metadata    Json?    @map("metadata")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// /filter and /analyze Models
// ---------------------------------------------------------------------------

/// Per-channel configuration documents for /analyze command.
/// Stores ICP, UseCases, Campaigns, and Settings markdown docs.
model ChannelConfigDoc {
  id               String        @id @default(uuid()) @db.Uuid
  slackTeamId      String        @map("slack_team_id")
  slackChannelId   String        @map("slack_channel_id")
  docType          ConfigDocType @map("doc_type")
  clientId         String?       @map("client_id") @db.Uuid
  content          String        @db.Text
  uploadedByUserId String        @map("uploaded_by_user_id")
  originalFileName String?       @map("original_file_name")
  displayLabel     String?       @map("display_label")
  s3Key            String?       @map("s3_key")
  originalMimeType String?       @map("original_mime_type")
  contentSizeBytes Int?          @map("content_size_bytes")
  version          Int           @default(1)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  client ManagedClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([slackTeamId, slackChannelId, docType])
  @@index([slackTeamId, slackChannelId])
  @@index([clientId])
  @@map("channel_config_docs")
}

/// Tracks /filter operations on uploaded lists.
model FilterJob {
  id             String          @id @default(uuid()) @db.Uuid
  slackChannelId String          @map("slack_channel_id")
  slackThreadTs  String          @map("slack_thread_ts")
  slackUserId    String          @map("slack_user_id")
  slackTeamId    String          @map("slack_team_id")
  status         FilterJobStatus @default(PENDING)
  sourceFileName String?         @map("source_file_name")
  sourceFileType SourceFileType? @map("source_file_type")
  sourceRowCount Int?            @map("source_row_count")
  resultRowCount Int?            @map("result_row_count")
