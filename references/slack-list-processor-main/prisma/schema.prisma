/// Stores OAuth installation data for each client workspace.
/// Created during OAuth callback, deleted 90 days after uninstall.
model WorkspaceInstallation {
  id                  String          @id @default(cuid())
  slackTeamId         String          @unique @map("slack_team_id")
  slackTeamName       String          @map("slack_team_name")
  botToken            String          @map("bot_token")
  botId               String          @map("bot_id")
  botUserId           String          @map("bot_user_id")
  appId               String          @map("app_id")
  installedByUserId   String          @map("installed_by_user_id")
  scopes              String
  status              WorkspaceStatus @default(ACTIVE)
  uninstalledAt       DateTime?       @map("uninstalled_at")
  purgeAfter          DateTime?       @map("purge_after")
  monthlySpendCapUsd  Decimal?        @map("monthly_spend_cap_usd")
  maxBuiltwithLookups Int?            @map("max_builtwith_lookups")
  maxApolloCredits    Int?            @map("max_apollo_credits")
  maxAiTokens         Int?            @map("max_ai_tokens")
  onboardingComplete  Boolean         @default(false) @map("onboarding_complete")
  settings            Json?           @db.JsonB
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  // Multi-tenant SaaS licensing fields (Feature 35)
  workspaceType          WorkspaceType   @default(CLIENT) @map("workspace_type")
  licenseKeyId           String?         @map("license_key_id")
  featureFlags           Json            @default("{}") @map("feature_flags") @db.JsonB
  onboardingStatus       OnboardingStep  @default(PENDING) @map("onboarding_status")
  clientDashboardEnabled Boolean         @default(true) @map("client_dashboard_enabled")

  // Vertical Pack Platform fields (Feature 39)
  dailySpendLimitUsd   Decimal?  @map("daily_spend_limit_usd") @db.Decimal(10, 2)
  dailySpendUsedUsd    Decimal   @default(0) @map("daily_spend_used_usd") @db.Decimal(10, 2)
  dailySpendResetAt    DateTime? @map("daily_spend_reset_at")

  // Relations
  agentThreads       AgentThread[]
  managedClients     ManagedClient[]
  promptClickEvents  PromptClickEvent[] @relation("PromptClickEvents")
  licenseKey         LicenseKey?        @relation(fields: [licenseKeyId], references: [id])
  enrichmentChannels EnrichmentChannel[]
  analysisChannel    AnalysisChannel?

  @@map("workspace_installations")
}

/// Represents a single agent conversation in the side-panel.
model AgentThread {
  id                 String            @id @default(cuid())
  slackThreadTs      String            @map("slack_thread_ts")
  slackChannelId     String            @map("slack_channel_id")
  slackUserId        String            @map("slack_user_id")
  slackTeamId        String            @map("slack_team_id")
  viewingChannelId   String?           @map("viewing_channel_id")
  viewingChannelName String?           @map("viewing_channel_name")
  title              String?
  status             AgentThreadStatus @default(ACTIVE)
  lastActivityAt     DateTime          @default(now()) @map("last_activity_at")
  createdAt          DateTime          @default(now()) @map("created_at")

  // Relations
  workspace  WorkspaceInstallation @relation(fields: [slackTeamId], references: [slackTeamId])
  turns      ConversationTurn[]
  audit      AgentThreadAudit?
  threadJobs AgentThreadJob[]

  @@index([slackTeamId, slackUserId])
  @@index([slackTeamId, slackThreadTs])
  @@index([status, lastActivityAt])
  @@map("agent_threads")
}

/// Individual message in an agent thread. Purged after 7 days.
model ConversationTurn {
  id              String           @id @default(cuid())
  agentThreadId   String           @map("agent_thread_id")
  role            ConversationRole
  content         String           @db.Text
  intent          String?
  confidence      Float?
  extractedParams Json?            @map("extracted_params") @db.JsonB
  tokensInput     Int?             @map("tokens_input")
  tokensOutput    Int?             @map("tokens_output")
  createdAt       DateTime         @default(now()) @map("created_at")

  // Relations
  agentThread AgentThread @relation(fields: [agentThreadId], references: [id], onDelete: Cascade)

  @@index([agentThreadId])
  @@index([createdAt])
  @@map("conversation_turns")
}

/// Compact audit summary generated before conversation turns are purged. Permanent retention.
model AgentThreadAudit {
  id                  String   @id @default(cuid())
  agentThreadId       String   @unique @map("agent_thread_id")
  slackTeamId         String   @map("slack_team_id")
  slackUserId         String   @map("slack_user_id")
  threadTitle         String?  @map("thread_title")
  turnCount           Int      @map("turn_count")
  intentsClassified   Json     @map("intents_classified") @db.JsonB
  jobsCreated         Json     @map("jobs_created") @db.JsonB
  actionsPerformed    Json     @map("actions_performed") @db.JsonB
  firstMessageAt      DateTime @map("first_message_at")
  lastMessageAt       DateTime @map("last_message_at")
  totalAiTokensInput  Int      @map("total_ai_tokens_input")
  totalAiTokensOutput Int      @map("total_ai_tokens_output")
  createdAt           DateTime @default(now()) @map("created_at")

  // Relations
  agentThread AgentThread @relation(fields: [agentThreadId], references: [id], onDelete: Cascade)

  @@index([slackTeamId])
  @@map("agent_thread_audits")
}

/// Junction table linking agent threads to jobs created within them.
model AgentThreadJob {
  id            String   @id @default(cuid())
  agentThreadId String   @map("agent_thread_id")
  jobId         String   @map("job_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  agentThread AgentThread @relation(fields: [agentThreadId], references: [id], onDelete: Cascade)
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([agentThreadId, jobId])
  @@index([agentThreadId])
  @@index([jobId])
  @@map("agent_thread_jobs")
}

