  updatedAt        DateTime                 @updatedAt @map("updated_at")

  // Relations
  workspace WorkspaceInstallation @relation(fields: [slackTeamId], references: [slackTeamId])

  @@unique([slackTeamId, slackChannelId])
  @@index([slackTeamId, assignedUserId])
  @@index([slackTeamId, status])
  @@map("enrichment_channels")
}

/// Per-workspace ICP & analysis channel designation for document-based context.
model AnalysisChannel {
  id                       String    @id @default(cuid())
  slackTeamId              String    @unique @map("slack_team_id")
  slackChannelId           String    @map("slack_channel_id")
  slackChannelName         String    @map("slack_channel_name")
  icpDocumentUrl           String?   @map("icp_document_url")
  useCasesDocumentUrl      String?   @map("use_cases_document_url")
  caseStudiesDocumentUrl   String?   @map("case_studies_document_url")
  testimonialsDocumentUrl  String?   @map("testimonials_document_url")
  icpExtractedText         String?   @map("icp_extracted_text")
  useCasesExtractedText    String?   @map("use_cases_extracted_text")
  caseStudiesExtractedText String?   @map("case_studies_extracted_text")
  testimonialsExtractedText String?  @map("testimonials_extracted_text")
  lastDocumentUploadAt     DateTime? @map("last_document_upload_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  // Relations
  workspace WorkspaceInstallation @relation(fields: [slackTeamId], references: [slackTeamId])

  @@index([slackChannelId])
  @@map("analysis_channels")
}

// ---------------------------------------------------------------------------
// Vertical Pack Platform Models (Feature 39)
// ---------------------------------------------------------------------------

/// The core reasoning unit. Backed by an LLM with a system prompt, tool access, and versioning.
model Agent {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  slug        String      @unique
  description String?     @db.Text
  status      AgentStatus @default(DRAFT)
  modelId     String      @map("model_id")
  maxTokens   Int         @map("max_tokens")
  creditCost  Decimal     @map("credit_cost") @db.Decimal(10, 4)
  inputSchema Json?       @map("input_schema") @db.JsonB
  outputSchema Json?      @map("output_schema") @db.JsonB
  toolIds     String[]    @default([]) @map("tool_ids")
  // Feature 31: Autonomous agent fields
  suggestOnlyMode       Boolean   @default(true) @map("suggest_only_mode")
  suggestOnlyApprovals  Int       @default(0) @map("suggest_only_approvals")
  suggestOnlyRejections Int       @default(0) @map("suggest_only_rejections")
  lastRunAt             DateTime? @map("last_run_at")
  actionsToday          Int       @default(0) @map("actions_today")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Relations
  versions    AgentVersion[]
  skills      Skill[]
  // Feature 31 relations
  teamAgents  TeamAgent[]

  @@index([status])
  @@map("agents")
}

/// Immutable snapshot of an agent's configuration at a point in time.
model AgentVersion {
  id           String      @id @default(uuid()) @db.Uuid
  agentId      String      @map("agent_id") @db.Uuid
  version      Int
  status       AgentStatus
  systemPrompt String      @map("system_prompt") @db.Text
  modelId      String      @map("model_id")
  maxTokens    Int         @map("max_tokens")
  toolIds      String[]    @default([]) @map("tool_ids")
  inputSchema  Json?       @map("input_schema") @db.JsonB
  outputSchema Json?       @map("output_schema") @db.JsonB
  changeNote   String?     @map("change_note")
  publishedAt  DateTime?   @map("published_at")
  publishedBy  String?     @map("published_by") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at")

  // Relations
  agent        Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skills       Skill[]     @relation("SkillAgentVersion")
  invocations  AgentInvocation[]

  @@unique([agentId, version])
  @@index([agentId, status])
  @@map("agent_versions")
}

/// An external service connection that exposes tools for agents to invoke.
model McpServer {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  slug           String          @unique
  provider       String
  baseUrl        String          @map("base_url")
  authType       McpAuthType     @map("auth_type")
  credentials    String?         @db.Text
  status         McpServerStatus @default(UNKNOWN)
  byokEnabled    Boolean         @default(false) @map("byok_enabled")
  rateLimitRpm   Int?            @map("rate_limit_rpm")
  lastHealthCheck DateTime?      @map("last_health_check")
  lastHealthError String?        @map("last_health_error") @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  // Relations
  tools          McpTool[]
  byokCredentials McpByokCredential[]

  @@index([status])
  @@map("mcp_servers")
}

/// A specific capability exposed by an MCP server.
model McpTool {
  id           String    @id @default(uuid()) @db.Uuid
  serverId     String    @map("server_id") @db.Uuid
  name         String
  description  String?   @db.Text
  inputSchema  Json?     @map("input_schema") @db.JsonB
  outputSchema Json?     @map("output_schema") @db.JsonB
  creditCost   Decimal   @default(0) @map("credit_cost") @db.Decimal(10, 4)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  server       McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, name])
  @@index([serverId])
  @@map("mcp_tools")
}

/// Per-workspace BYOK credentials for an MCP server.
model McpByokCredential {
  id           String    @id @default(uuid()) @db.Uuid
  serverId     String    @map("server_id") @db.Uuid
  slackTeamId  String    @map("slack_team_id")
  credentials  String    @db.Text
  isValid      Boolean   @default(true) @map("is_valid")
  lastValidatedAt DateTime? @map("last_validated_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  server       McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, slackTeamId])
  @@index([slackTeamId])
  @@map("mcp_byok_credentials")
}

/// A composable execution unit combining an agent, MCP tools, trigger, and delivery.
model Skill {
  id              String              @id @default(uuid()) @db.Uuid
  name            String
  slug            String              @unique
  description     String?             @db.Text
  status          SkillStatus         @default(DRAFT)
  agentId         String              @map("agent_id") @db.Uuid
  agentVersionId  String              @map("agent_version_id") @db.Uuid
  triggerType     SkillTriggerType    @map("trigger_type")
  triggerConfig   Json?               @map("trigger_config") @db.JsonB
  deliveryChannels SkillDeliveryChannel[] @map("delivery_channels")
  deliveryConfig  Json?               @map("delivery_config") @db.JsonB
  mcpToolIds      String[]            @default([]) @map("mcp_tool_ids")
  inputMapping    Json?               @map("input_mapping") @db.JsonB
  outputMapping   Json?               @map("output_mapping") @db.JsonB
  creditCost      Decimal             @map("credit_cost") @db.Decimal(10, 4)
  retryPolicy     Json?               @map("retry_policy") @db.JsonB
  chainEventName  String?             @map("chain_event_name")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  // Relations
  agent          Agent               @relation(fields: [agentId], references: [id])
  agentVersion   AgentVersion        @relation("SkillAgentVersion", fields: [agentVersionId], references: [id])
  packSkills     PackSkill[]
  executions     SkillExecution[]

  @@index([status])
  @@index([agentId])
  @@index([triggerType])
  @@map("skills")
}

/// A curated bundle of skills marketed for a specific use case.
model VerticalPack {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  slug            String      @unique
  description     String?     @db.Text
  category        PackCategory
  status          PackStatus  @default(DRAFT)
  tier            PackTier
  monthlyPriceUsd Decimal?    @map("monthly_price_usd") @db.Decimal(10, 2)
  creditsIncluded Int         @map("credits_included")
  overageRateUsd  Decimal?    @map("overage_rate_usd") @db.Decimal(10, 4)
  stripePriceId   String?     @map("stripe_price_id")
  displayOrder    Int         @default(0) @map("display_order")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  packSkills    PackSkill[]
  subscriptions PackSubscription[]

  @@index([status])
  @@index([category])
  @@map("vertical_packs")
}

/// Many-to-many junction between packs and skills.
model PackSkill {
  id        String   @id @default(uuid()) @db.Uuid
  packId    String   @map("pack_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  pack  VerticalPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  skill Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([packId, skillId])
  @@index([packId])
  @@index([skillId])
  @@map("pack_skills")
}

/// A workspace's active subscription to a vertical pack.
model PackSubscription {
  id                String             @id @default(uuid()) @db.Uuid
  packId            String             @map("pack_id") @db.Uuid
  slackTeamId       String             @map("slack_team_id")
  status            SubscriptionStatus @default(ACTIVE)
  creditsIncluded   Int                @map("credits_included")
  creditsUsed       Int                @default(0) @map("credits_used")
  overageRateUsd    Decimal?           @map("overage_rate_usd") @db.Decimal(10, 4)
  currentPeriodStart DateTime          @map("current_period_start")
  currentPeriodEnd   DateTime          @map("current_period_end")
  stripeSubscriptionId String?         @map("stripe_subscription_id")
  cancelledAt       DateTime?          @map("cancelled_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  // Relations
  pack             VerticalPack      @relation(fields: [packId], references: [id])
  creditTransactions PackCreditTransaction[]

  @@unique([packId, slackTeamId])
  @@index([slackTeamId])
  @@index([status])
  @@map("pack_subscriptions")
}

/// Append-only credit ledger for pack subscriptions.
model PackCreditTransaction {
  id                 String   @id @default(uuid()) @db.Uuid
  packSubscriptionId String   @map("pack_subscription_id") @db.Uuid
  type               CreditTransactionType
  amount             Int
  balanceAfter       Int      @map("balance_after")
  referenceId        String?  @map("reference_id")
  description        String   @db.Text
  metadata           Json?    @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at")

  // Relations
  packSubscription PackSubscription @relation(fields: [packSubscriptionId], references: [id], onDelete: Cascade)

  @@index([packSubscriptionId])
  @@index([type])
  @@index([createdAt])
  @@map("pack_credit_transactions")
}

/// A full end-to-end run of a skill, tracking the entire pipeline.
model SkillExecution {
  id               String               @id @default(uuid()) @db.Uuid
  skillId          String               @map("skill_id") @db.Uuid
  slackTeamId      String               @map("slack_team_id")
  slackUserId      String?              @map("slack_user_id")
  status           SkillExecutionStatus @default(QUEUED)
  triggerType      SkillTriggerType     @map("trigger_type")
  triggerSource    String?              @map("trigger_source")
  input            Json?                @db.JsonB
  output           Json?                @db.JsonB
  creditsCost      Decimal              @default(0) @map("credits_cost") @db.Decimal(10, 4)
  packSubscriptionId String?            @map("pack_subscription_id") @db.Uuid
  bullmqJobId      String?              @map("bullmq_job_id")
  errorMessage     String?              @map("error_message") @db.Text
  retryCount       Int                  @default(0) @map("retry_count")
  executionTrace   Json?                @map("execution_trace") @db.JsonB
  startedAt        DateTime?            @map("started_at")
  completedAt      DateTime?            @map("completed_at")
  createdAt        DateTime             @default(now()) @map("created_at")

  // Relations
  skill            Skill                @relation(fields: [skillId], references: [id])
  agentInvocations AgentInvocation[]
  // Feature 31 reverse relations
  auditActions     AuditAction[]
  pendingActions   PendingAction[]

  @@index([skillId])
  @@index([slackTeamId])
  @@index([status])
  @@index([createdAt])
  @@index([packSubscriptionId])
  @@map("skill_executions")
}

/// A single LLM call within a skill execution.
model AgentInvocation {
  id               String    @id @default(uuid()) @db.Uuid
  executionId      String    @map("execution_id") @db.Uuid
  agentVersionId   String    @map("agent_version_id") @db.Uuid
  input            Json?     @db.JsonB
  output           Json?     @db.JsonB
  tokensInput      Int       @default(0) @map("tokens_input")
  tokensOutput     Int       @default(0) @map("tokens_output")
  costUsd          Decimal   @default(0) @map("cost_usd") @db.Decimal(10, 6)
  modelId          String    @map("model_id")
  durationMs       Int       @default(0) @map("duration_ms")
  toolCallsMade    Json?     @map("tool_calls_made") @db.JsonB
  errorMessage     String?   @map("error_message") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")

  // Relations
  execution       SkillExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  agentVersion    AgentVersion   @relation(fields: [agentVersionId], references: [id])

  @@index([executionId])
  @@index([agentVersionId])
  @@index([createdAt])
  @@map("agent_invocations")
}

// ---------------------------------------------------------------------------
// Autonomous Agents Models (Feature 31)
// ---------------------------------------------------------------------------

/// A named group of collaborating agents (also referred to as "Cluster").
model Team {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  slug        String     @unique
  description String?    @db.Text
  status      TeamStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  teamAgents  TeamAgent[]

  @@index([status])
  @@map("teams")
}

/// Many-to-many junction between Teams and Agents.
model TeamAgent {
  id        String @id @default(uuid()) @db.Uuid
  teamId    String @map("team_id") @db.Uuid
  agentId   String @map("agent_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  // Relations
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([teamId, agentId])
  @@index([teamId])
  @@index([agentId])
  @@map("team_agents")
}

/// Database audit trail for all autonomous agent actions.
model AuditAction {
  id                    String       @id @default(uuid()) @db.Uuid
  agentName             String       @map("agent_name")
  action                String
  confidence            Float
  severity              Severity
  metadata              Json         @db.JsonB
  specialtyExecutionId  String?      @map("specialty_execution_id") @db.Uuid
  outcome               AuditOutcome
  adminUserId           String?      @map("admin_user_id") @db.Uuid
  timestamp             DateTime     @default(now())

  // Relations
  specialtyExecution    SkillExecution? @relation(fields: [specialtyExecutionId], references: [id])
  adminUser             AdminUser?      @relation(fields: [adminUserId], references: [id])

  @@index([agentName, timestamp])
  @@index([timestamp])
  @@index([outcome, timestamp])
  @@index([severity, timestamp])
  @@map("audit_actions")
}

/// Per-worker concurrency settings managed by the API Rate Limit Manager Agent.
model WorkerConfig {
  id          String   @id @default(uuid()) @db.Uuid
  workerName  String   @unique @map("worker_name")
  concurrency Int
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String   @map("updated_by")
  reason      String   @db.Text

  @@index([workerName])
  @@map("worker_configs")
}

/// System-level events generated by autonomous agents for admin dashboard visibility.
model SystemEvent {
  id             String   @id @default(uuid()) @db.Uuid
  type           String
  severity       Severity
  message        String   @db.Text
  metadata       Json     @db.JsonB
  agentName      String?  @map("agent_name")
  acknowledged   Boolean  @default(false)
  acknowledgedBy String?  @map("acknowledged_by")
  acknowledgedAt DateTime? @map("acknowledged_at")
  timestamp      DateTime @default(now())

  @@index([type, timestamp])
  @@index([severity, timestamp])
  @@index([acknowledged, timestamp])
  @@map("system_events")
}

/// Aggregated campaign performance data for Campaign Optimization Agent.
model CampaignMetrics {
  id            String   @id @default(uuid()) @db.Uuid
  campaignId    String   @map("campaign_id")
  sendHour      Int
  openRate      Float    @map("open_rate")
  responseRate  Float    @map("response_rate")
  sendCount     Int      @map("send_count")
  abTestVariant String?  @map("ab_test_variant")
  lastUpdated   DateTime @updatedAt @map("last_updated")

  @@unique([campaignId, sendHour, abTestVariant])
  @@index([campaignId])
  @@map("campaign_metrics")
}

/// CRM conflict resolution decisions for supervised learning.
model ConflictDecision {
  id          String          @id @default(uuid()) @db.Uuid
  conflictId  String          @map("conflict_id")
  confidence  Float
  features    Json            @db.JsonB
  outcome     ConflictOutcome
  adminUserId String?         @map("admin_user_id") @db.Uuid
  metadata    Json?           @db.JsonB
  timestamp   DateTime        @default(now())

  // Relations
  adminUser   AdminUser?      @relation(fields: [adminUserId], references: [id])

  @@index([outcome, timestamp])
  @@index([conflictId])
  @@map("conflict_decisions")
}

/// Autonomous agent recommended action awaiting admin approval.
model PendingAction {
  id                    String              @id @default(uuid()) @db.Uuid
  agentName             String              @map("agent_name")
  action                String
  confidence            Float
  metadata              Json                @db.JsonB
  specialtyExecutionId  String?             @map("specialty_execution_id") @db.Uuid
  status                PendingActionStatus @default(PENDING)
  reviewedBy            String?             @map("reviewed_by")
  reviewedAt            DateTime?           @map("reviewed_at")
  createdAt             DateTime            @default(now()) @map("created_at")

  // Relations
  specialtyExecution    SkillExecution?     @relation(fields: [specialtyExecutionId], references: [id])

  @@index([status, createdAt])
  @@index([agentName, status])
  @@map("pending_actions")
}
