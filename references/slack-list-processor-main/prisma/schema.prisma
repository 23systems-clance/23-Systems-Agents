/// Centralized error tracking with lifecycle states.
model ErrorLog {
  id             String              @id @default(uuid()) @db.Uuid
  category       ErrorCategory
  service        String
  message        String              @db.Text
  stackTrace     String?             @map("stack_trace") @db.Text
  jobId          String?             @map("job_id") @db.Uuid
  slackUserId    String?             @map("slack_user_id")
  slackChannelId String?             @map("slack_channel_id")
  slackTeamId    String?             @map("slack_team_id")
  metadata       Json?               @db.JsonB
  lifecycleState ErrorLifecycleState @default(OPEN) @map("lifecycle_state")
  acknowledgedBy String?             @map("acknowledged_by") @db.Uuid
  acknowledgedAt DateTime?           @map("acknowledged_at")
  resolvedBy     String?             @map("resolved_by") @db.Uuid
  resolvedAt     DateTime?           @map("resolved_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  // Relations
  job               Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  acknowledgedAdmin AdminUser? @relation("ErrorAcknowledgedBy", fields: [acknowledgedBy], references: [id], onDelete: SetNull)
  resolvedAdmin     AdminUser? @relation("ErrorResolvedBy", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([service])
  @@index([lifecycleState])
  @@index([jobId])
  @@index([slackTeamId])
  @@index([createdAt])
  @@map("error_logs")
}

/// Configurable spending limits with monthly reset and Slack alerting.
model BudgetThreshold {
