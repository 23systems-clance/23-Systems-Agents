/// Central campaign entity for multi-channel outreach orchestration.
/// Lifecycle: DRAFT -> ACTIVE -> PAUSED -> COMPLETED -> ARCHIVED
model Campaign {
  id                   String         @id @default(uuid()) @db.Uuid
  slackTeamId          String         @map("slack_team_id")
  name                 String
  description          String?        @db.Text
  campaignType         CampaignType   @map("campaign_type")
  status               CampaignStatus @default(DRAFT)
  icpDefinition        String?        @map("icp_definition") @db.Text
  meetingLink          String?        @map("meeting_link")
  callScript           String?        @map("call_script") @db.Text
  emailSequenceCopy    String?        @map("email_sequence_copy") @db.Text
  linkedinSequenceCopy String?        @map("linkedin_sequence_copy") @db.Text
  hubspotListId        String?        @map("hubspot_list_id")
  externalListId       String?        @map("external_list_id")
  instantlyCampaignId  String?        @map("instantly_campaign_id")
  heyreachCampaignId   String?        @map("heyreach_campaign_id")
  totalContacts        Int            @default(0) @map("total_contacts")
  activeContacts       Int            @default(0) @map("active_contacts")
  completedContacts    Int            @default(0) @map("completed_contacts")
  clientId             String?        @map("client_id") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  // Relations
  client                ManagedClient?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  sequenceSteps         CampaignSequenceStep[]
  contacts              CampaignContact[]
  bdrs                  CampaignBdr[]
  dailyActivities       DailyBdrActivity[]
  eodReports            EodReport[]
  uniboxReplies         UniboxReply[]
  onboardingEnrollments OnboardingEnrollment[]
  dialerSessions        DialerSession[]

  @@index([slackTeamId])
  @@index([status])
  @@index([clientId])
  @@index([createdAt])
  @@map("campaigns")
}

/// An ordered step within a campaign's outreach sequence.
model CampaignSequenceStep {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  stepOrder  Int      @map("step_order")
  stepType   StepType @map("step_type")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, stepOrder])
  @@index([campaignId])
  @@map("campaign_sequence_steps")
}

/// A contact imported from HubSpot into a campaign with sequence tracking.
model CampaignContact {
  id               String                @id @default(uuid()) @db.Uuid
  campaignId       String                @map("campaign_id") @db.Uuid
  hubspotContactId String?               @map("hubspot_contact_id")
  firstName        String                @map("first_name")
  lastName         String                @map("last_name")
  email            String?
  emailVerified    Boolean               @default(false) @map("email_verified")
  mobilePhone      String?               @map("mobile_phone")
  directPhone      String?               @map("direct_phone")
  linkedinUrl      String?               @map("linkedin_url")
  companyName      String?               @map("company_name")
  jobTitle         String?               @map("job_title")
  currentStepIndex Int                   @default(0) @map("current_step_index")
  status           ContactCampaignStatus @default(ACTIVE)
  statusReason     String?               @map("status_reason")
  resolvedPhone    String?               @map("resolved_phone")
  canEmail         Boolean               @default(false) @map("can_email")
  canCall          Boolean               @default(false) @map("can_call")
  canLinkedin      Boolean               @default(false) @map("can_linkedin")
  startedAt        DateTime?             @map("started_at")
  completedAt      DateTime?             @map("completed_at")
  lastActivityAt   DateTime?             @map("last_activity_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  // Personality enrichment (populated via on-demand enrichment)
  personalityData       Json?     @map("personality_data") @db.JsonB
  personalityEnrichedAt DateTime? @map("personality_enriched_at")

  // Relations
  campaign           Campaign                       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stepExecutions     CampaignContactStepExecution[]
  uniboxReplies      UniboxReply[]
  dialerCallSessions CallSession[]
  dialerQueueItems   DialerQueueItem[]

  @@index([campaignId])
  @@index([status])
  @@index([campaignId, currentStepIndex])
  @@index([campaignId, status])
  @@map("campaign_contacts")
}

/// Per-step execution record tracking what happened at each sequence step.
model CampaignContactStepExecution {
  id                String              @id @default(uuid()) @db.Uuid
  campaignContactId String              @map("campaign_contact_id") @db.Uuid
  stepIndex         Int                 @map("step_index")
  stepType          StepType            @map("step_type")
  status            StepExecutionStatus @default(PENDING)
  result            String?
  externalId        String?             @map("external_id")
  firedAt           DateTime?           @map("fired_at")
  completedAt       DateTime?           @map("completed_at")
  createdAt         DateTime            @default(now()) @map("created_at")

  // Relations
  campaignContact   CampaignContact  @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  dialerCallSession CallSession?
  dialerQueueItem   DialerQueueItem?

  @@index([campaignContactId])
  @@index([status])
  @@index([campaignContactId, stepIndex])
  @@map("campaign_contact_step_executions")
}

/// Junction table linking a BDR (Slack user) to a campaign.
model CampaignBdr {
  id          String   @id @default(uuid()) @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  slackUserId String   @map("slack_user_id")
  slackTeamId String   @map("slack_team_id")
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, slackUserId])
  @@index([campaignId])
  @@index([slackUserId])
  @@map("campaign_bdrs")
}

/// Audit log for all inbound webhooks from Instantly and HeyReach.
model WebhookEvent {
  id                 String        @id @default(uuid()) @db.Uuid
  source             WebhookSource
  eventType          String        @map("event_type")
  campaignId         String?       @map("campaign_id") @db.Uuid
  contactEmail       String?       @map("contact_email")
  contactLinkedinUrl String?       @map("contact_linkedin_url")
  rawPayload         Json          @map("raw_payload") @db.JsonB
  processed          Boolean       @default(false)
  processedAt        DateTime?     @map("processed_at")
  createdAt          DateTime      @default(now()) @map("created_at")

  @@index([source, processed])
  @@index([contactEmail])
  @@index([campaignId])
  @@index([createdAt])
  @@map("webhook_events")
}

/// Stored reply data from Instantly/HeyReach webhooks for the UniBox.
model UniboxReply {
  id                String       @id @default(uuid()) @db.Uuid
  campaignId        String       @map("campaign_id") @db.Uuid
  campaignContactId String?      @map("campaign_contact_id") @db.Uuid
  channel           ReplyChannel
  fromName          String?      @map("from_name")
  fromEmail         String?      @map("from_email")
  fromLinkedinUrl   String?      @map("from_linkedin_url")
  subject           String?
  body              String       @db.Text
  rawPayload        Json?        @map("raw_payload") @db.JsonB
  externalId        String?      @map("external_id")
  isRead            Boolean      @default(false) @map("is_read")
  receivedAt        DateTime     @map("received_at")
  createdAt         DateTime     @default(now()) @map("created_at")

  // Smart Reply Draft fields (all nullable for backwards compatibility)
  draftBody        String?               @map("draft_body") @db.Text
  draftStatus      SmartReplyDraftStatus? @map("draft_status")
  draftIntent      String?               @map("draft_intent")
  draftGeneratedAt DateTime?             @map("draft_generated_at")
  draftTokensUsed  Int?                  @map("draft_tokens_used")
  draftCostUsd     Decimal?              @map("draft_cost_usd") @db.Decimal(10, 6)
  draftError       String?               @map("draft_error") @db.Text

  // Relations
  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignContact CampaignContact? @relation(fields: [campaignContactId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([campaignContactId])
  @@index([isRead])
  @@index([receivedAt])
  @@index([draftStatus])
  @@map("unibox_replies")
}

/// Aggregated daily stats per BDR per campaign.
model DailyBdrActivity {
  id                      String   @id @default(uuid()) @db.Uuid
  campaignId              String   @map("campaign_id") @db.Uuid
  slackUserId             String   @map("slack_user_id")
  date                    DateTime @db.Date
  emailsSent              Int      @default(0) @map("emails_sent")
  linkedinActionsSent     Int      @default(0) @map("linkedin_actions_sent")
  callsCompleted          Int      @default(0) @map("calls_completed")
  emailRepliesReceived    Int      @default(0) @map("email_replies_received")
  linkedinRepliesReceived Int      @default(0) @map("linkedin_replies_received")
  supervised              Boolean  @default(false)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, slackUserId, date])
  @@index([slackUserId, date])
  @@index([campaignId])
  @@map("daily_bdr_activities")
}

/// End-of-day report per BDR with automated stats and optional notes.
model EodReport {
  id          String   @id @default(uuid()) @db.Uuid
  campaignId  String?  @map("campaign_id") @db.Uuid
  slackUserId String   @map("slack_user_id")
  slackTeamId String   @map("slack_team_id")
  date        DateTime @db.Date
  stats       Json     @db.JsonB
  bdrNotes    String?  @map("bdr_notes") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([slackUserId, date])
  @@index([slackTeamId, date])
  @@map("eod_reports")
}

// ---------------------------------------------------------------------------
// Client & BDR Management Models
// ---------------------------------------------------------------------------

/// A business client entity with encrypted external API keys.
/// Each client owns their own Instantly, HeyReach, and HubSpot credentials.
model ManagedClient {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  slug            String   @unique
  slackTeamId     String?  @map("slack_team_id")
  instantlyApiKey String?  @map("instantly_api_key") @db.Text
  heyreachApiKey  String?  @map("heyreach_api_key") @db.Text
  hubspotApiKey   String?  @map("hubspot_api_key") @db.Text
  hubspotPortalId String?  @map("hubspot_portal_id")
  isActive                  Boolean  @default(true) @map("is_active")
  connectedCallTimerSeconds Int      @default(45) @map("connected_call_timer_seconds")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  // Relations
  workspace           WorkspaceInstallation? @relation(fields: [slackTeamId], references: [slackTeamId])
  bdrs                BdrClient[]
  campaigns           Campaign[]
  channelMappings     ChannelClientMapping[]
  jobs                Job[]
  creditTransactions  CreditTransaction[]
  hubspotConnection   HubSpotConnection?
  qualityGateConfig   QualityGateConfig?
  crmConnections      CrmConnection[]
  workflows           WorkflowTemplate[]
  configDocs          ChannelConfigDoc[]
  dialerSessions      DialerSession[]
  callSessions        CallSession[]
  callRecordings      CallRecording[]
  callQualityMetrics  CallQualityMetric[]
  twilioPhoneNumbers  TwilioPhoneNumber[]
  uncallableContacts  UncallableContact[]
  analyticsSavedViews AnalyticsSavedView[]
  scheduledCallbacks  ScheduledCallback[]

  @@index([isActive])
  @@index([slackTeamId])
  @@map("managed_clients")
}

/// Maps a Slack channel to a ManagedClient for config doc association.
model ChannelClientMapping {
  id              String   @id @default(uuid()) @db.Uuid
  slackTeamId     String   @map("slack_team_id")
  slackChannelId  String   @map("slack_channel_id")
  clientId        String   @map("client_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  client ManagedClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([slackTeamId, slackChannelId])
  @@index([clientId])
  @@map("channel_client_mappings")
}

/// A Business Development Representative linked to a Slack user.
model Bdr {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  email       String?
  managerId   String?  @map("manager_id")
  slackUserId String   @map("slack_user_id")
  slackTeamId String   @map("slack_team_id")
  isActive    Boolean  @default(true) @map("is_active")
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  clients            BdrClient[]
  dialerSessions     DialerSession[]
  callSessions       CallSession[]
  callRecordings     CallRecording[]
  callQualityMetrics CallQualityMetric[]
  scheduledCallbacks ScheduledCallback[]

  @@unique([slackUserId, slackTeamId])
  @@index([slackUserId])
  @@index([isActive])
  @@map("bdrs")
}

/// Many-to-many junction between BDRs and Clients.
model BdrClient {
  id        String   @id @default(uuid()) @db.Uuid
  bdrId     String   @map("bdr_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  bdr    Bdr           @relation(fields: [bdrId], references: [id], onDelete: Cascade)
  client ManagedClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([bdrId, clientId])
  @@index([bdrId])
  @@index([clientId])
  @@map("bdr_clients")
}

// ---------------------------------------------------------------------------
// BDR Onboarding Agent Models (Feature 7)
// ---------------------------------------------------------------------------

/// A reusable template defining a BDR onboarding program structure.
/// Plans are versioned — edits create new records with incremented version numbers.
model OnboardingPlan {
  id                 String   @id @default(uuid()) @db.Uuid
  slackTeamId        String   @map("slack_team_id")
  name               String
  description        String?  @db.Text
  durationDays       Int      @map("duration_days")
  supervisedStartDay Int?     @map("supervised_start_day")
  version            Int      @default(1)
  isLatest           Boolean  @default(true) @map("is_latest")
  parentPlanId       String?  @map("parent_plan_id") @db.Uuid
  weekdaysOnly       Boolean  @default(true) @map("weekdays_only")
  createdByUserId    String   @map("created_by_user_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  parentPlan  OnboardingPlan?        @relation("PlanVersions", fields: [parentPlanId], references: [id], onDelete: SetNull)
  childPlans  OnboardingPlan[]       @relation("PlanVersions")
  modules     OnboardingModule[]
  enrollments OnboardingEnrollment[]

  @@index([slackTeamId, isLatest])
  @@index([parentPlanId])
  @@map("onboarding_plans")
}

/// A single day's training content within a plan.
model OnboardingModule {
  id               String   @id @default(uuid()) @db.Uuid
  planId           String   @map("plan_id") @db.Uuid
  dayNumber        Int      @map("day_number")
  weekNumber       Int      @map("week_number")
  title            String
  description      String?  @db.Text
  estimatedMinutes Int?     @map("estimated_minutes")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  plan           OnboardingPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  trainingItems  TrainingItem[]
  automations    OnboardingAutomation[]
  moduleProgress ModuleProgress[]

  @@unique([planId, dayNumber])
  @@index([planId, dayNumber])
  @@map("onboarding_modules")
}

/// An individual piece of training content within a module.
model TrainingItem {
  id               String           @id @default(uuid()) @db.Uuid
  moduleId         String           @map("module_id") @db.Uuid
  type             TrainingItemType
  title            String
  content          String?          @db.Text
  metadata         Json?            @db.JsonB
  estimatedMinutes Int?             @map("estimated_minutes")
  sortOrder        Int              @default(0) @map("sort_order")
  libraryItemId    String?          @map("library_item_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  module      OnboardingModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  libraryItem ContentLibraryItem? @relation(fields: [libraryItemId], references: [id], onDelete: SetNull)

  @@index([moduleId, sortOrder])
  @@map("training_items")
}

/// A scheduled action attached to a module/day.
model OnboardingAutomation {
  id          String         @id @default(uuid()) @db.Uuid
  moduleId    String         @map("module_id") @db.Uuid
  type        AutomationType
  triggerTime String         @map("trigger_time")
  content     String?        @db.Text
  conditions  Json?          @db.JsonB
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at")

  // Relations
  module           OnboardingModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  checkinResponses CheckinResponse[]

  @@index([moduleId])
  @@map("onboarding_automations")
}

/// An instance of a BDR going through an onboarding plan.
model OnboardingEnrollment {
  id                   String                     @id @default(uuid()) @db.Uuid
  slackTeamId          String                     @map("slack_team_id")
  slackUserId          String                     @map("slack_user_id")
  bdrName              String                     @map("bdr_name")
  planId               String                     @map("plan_id") @db.Uuid
  managerId            String                     @map("manager_id")
  startDate            DateTime                   @map("start_date") @db.Date
  deliveryHour         Int                        @map("delivery_hour")
  timezone             String
  status               OnboardingEnrollmentStatus @default(ACTIVE)
  currentDay           Int                        @default(0) @map("current_day")
  supervisedCampaignId String?                    @map("supervised_campaign_id") @db.Uuid
  graduatedAt          DateTime?                  @map("graduated_at")
  cancelledAt          DateTime?                  @map("cancelled_at")
  extendedDays         Int                        @default(0) @map("extended_days")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  // Relations
  plan               OnboardingPlan    @relation(fields: [planId], references: [id])
  supervisedCampaign Campaign?         @relation(fields: [supervisedCampaignId], references: [id], onDelete: SetNull)
  moduleProgress     ModuleProgress[]
  checkinResponses   CheckinResponse[]

  @@index([slackUserId, status])
  @@index([slackTeamId, status])
  @@index([planId])
  @@map("onboarding_enrollments")
}

/// Per-module completion tracking for an enrolled BDR.
model ModuleProgress {
  id                  String                 @id @default(uuid()) @db.Uuid
  enrollmentId        String                 @map("enrollment_id") @db.Uuid
  moduleId            String                 @map("module_id") @db.Uuid
  dayNumber           Int                    @map("day_number")
  status              OnboardingModuleStatus @default(PENDING)
  deliveredAt         DateTime?              @map("delivered_at")
  completedAt         DateTime?              @map("completed_at")
  quizResponses       Json?                  @map("quiz_responses") @db.JsonB
  quizScore           Float?                 @map("quiz_score")
  practiceSubmission  String?                @map("practice_submission") @db.Text
  managerReviewStatus ManagerReviewStatus?   @map("manager_review_status")
  managerReviewedAt   DateTime?              @map("manager_reviewed_at")
  checklistProgress   Json?                  @map("checklist_progress") @db.JsonB
  deliveryMessageTs   String?                @map("delivery_message_ts")
  deliveryFailed      Boolean                @default(false) @map("delivery_failed")
  deliveryError       String?                @map("delivery_error") @db.Text
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  // Relations
  enrollment OnboardingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  module     OnboardingModule     @relation(fields: [moduleId], references: [id])

  @@unique([enrollmentId, dayNumber])
  @@index([enrollmentId, dayNumber])
  @@index([enrollmentId, status])
  @@map("module_progress")
}

/// Records BDR responses to check-in prompts.
model CheckinResponse {
  id           String   @id @default(uuid()) @db.Uuid
  enrollmentId String   @map("enrollment_id") @db.Uuid
  automationId String   @map("automation_id") @db.Uuid
  dayNumber    Int      @map("day_number")
  response     String   @db.Text
  respondedAt  DateTime @default(now()) @map("responded_at")

  // Relations
  enrollment OnboardingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  automation OnboardingAutomation @relation(fields: [automationId], references: [id])

  @@index([enrollmentId, dayNumber])
  @@map("checkin_responses")
}

// ---------------------------------------------------------------------------
// Visual Workflow Builder Enums (Feature 7-workflow-builder)
// ---------------------------------------------------------------------------

enum WorkflowTriggerType {
  FILE_UPLOAD
  KEYWORD
  SLASH_COMMAND
  MANUAL
  WEBHOOK
}

enum WorkflowVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkflowExecutionStatus {
  ACTIVE
  WAITING_INPUT
  WAITING_DELAY
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum WorkflowNodeType {
  TRIGGER
  MESSAGE
  BUTTON_CHOICE
  FORM_MODAL
  ENRICHMENT
  CONDITION
  ACTION
  DELAY
  HUBSPOT
  PARSER
  API_CALL
}

enum WebhookEndpointStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// Visual Workflow Builder Models (Feature 7-workflow-builder)
// ---------------------------------------------------------------------------

/// A named workflow "blueprint" representing a Slack interaction flow.
/// Owns all versions. Scoped to an optional client for per-client workflow routing.
model WorkflowTemplate {
  id              String              @id @default(uuid()) @db.Uuid
  slackTeamId     String              @map("slack_team_id")
  name            String
  description     String?             @db.Text
  triggerType     WorkflowTriggerType @map("trigger_type")
  isActive        Boolean             @default(false) @map("is_active")
  clientId        String?             @map("client_id") @db.Uuid
  createdByUserId String              @map("created_by_user_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  // Relations
  client           ManagedClient?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  versions         WorkflowVersion[]
  webhookEndpoints WebhookEndpoint[]
  channelMappings  WorkflowChannelMapping[]

  @@index([slackTeamId])
  @@index([slackTeamId, triggerType])
  @@index([clientId])
  @@index([slackTeamId, triggerType, clientId])
  @@map("workflow_templates")
}

/// Maps a Slack channel directly to a specific workflow, scoped by trigger type.
/// Provides channel-level override (tier-1) in the 3-tier workflow resolution.
model WorkflowChannelMapping {
  id              String              @id @default(uuid()) @db.Uuid
  templateId      String              @map("template_id") @db.Uuid
  slackChannelId  String              @map("slack_channel_id")
  slackTeamId     String              @map("slack_team_id")
  triggerType     WorkflowTriggerType @map("trigger_type")
  createdByUserId String              @map("created_by_user_id")
  createdAt       DateTime            @default(now()) @map("created_at")

  // Relations
  template WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([slackTeamId, slackChannelId, triggerType])
  @@index([templateId])
  @@index([slackTeamId, slackChannelId])
  @@map("workflow_channel_mappings")
}

/// A point-in-time snapshot of a workflow's graph configuration.
/// Each publish creates a new version; executions are pinned to a specific version.
model WorkflowVersion {
  id                String                @id @default(uuid()) @db.Uuid
  templateId        String                @map("template_id") @db.Uuid
  version           Int                   @default(1)
  status            WorkflowVersionStatus @default(DRAFT)
  graph             Json                  @db.JsonB
  publishedAt       DateTime?             @map("published_at")
  publishedByUserId String?               @map("published_by_user_id")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  // Relations
  template         WorkflowTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  executions       WorkflowExecution[]
  webhookEndpoints WebhookEndpoint[]

  @@unique([templateId, version])
  @@index([templateId, status])
  @@map("workflow_versions")
}

/// A single run of a workflow by a Slack user. Pinned to a specific version via FK.
/// Contains nodeHistory JSONB array for per-node execution analytics.
model WorkflowExecution {
  id             String                  @id @default(uuid()) @db.Uuid
  versionId      String                  @map("version_id") @db.Uuid
  slackTeamId    String                  @map("slack_team_id")
  slackUserId    String                  @map("slack_user_id")
  slackChannelId String                  @map("slack_channel_id")
  slackThreadTs  String?                 @map("slack_thread_ts")
  status         WorkflowExecutionStatus @default(ACTIVE)
  currentNodeId  String?                 @map("current_node_id")
  context        Json                    @default("{}") @db.JsonB
  nodeHistory    Json                    @default("[]") @db.JsonB
  nodeProgress   Json?                   @map("node_progress") @db.JsonB
  webhookToken   String?                 @map("webhook_token")
  errorMessage   String?                 @map("error_message") @db.Text
  expiresAt      DateTime                @map("expires_at")
  startedAt      DateTime                @default(now()) @map("started_at")
  completedAt    DateTime?               @map("completed_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  // Relations
  version     WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  webhookLogs WebhookLog[]

  @@index([slackTeamId, slackUserId])
  @@index([slackChannelId, slackThreadTs])
  @@index([status])
  @@index([expiresAt])
  @@index([versionId])
  @@map("workflow_executions")
}

/// A generated webhook URL tied to a workflow's TRIGGER node.
/// Created on publish, deactivated on archive.
model WebhookEndpoint {
  id           String                @id @default(uuid()) @db.Uuid
  templateId   String                @map("template_id") @db.Uuid
  versionId    String                @map("version_id") @db.Uuid
  token        String                @unique
  hmacSecret   String                @map("hmac_secret")
  description  String?
  status       WebhookEndpointStatus @default(ACTIVE)
  totalCalls   Int                   @default(0) @map("total_calls")
  lastCalledAt DateTime?             @map("last_called_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  // Relations
  template WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version  WorkflowVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  logs     WebhookLog[]

  @@index([templateId])
  @@index([status])
  @@map("webhook_endpoints")
}

/// Log of incoming webhook requests for auditability.
model WebhookLog {
  id             String   @id @default(uuid()) @db.Uuid
  endpointId     String   @map("endpoint_id") @db.Uuid
  sourceIp       String?  @map("source_ip")
  validated      Boolean
  payloadHash    String?  @map("payload_hash")
  responseStatus Int      @map("response_status")
  executionId    String?  @map("execution_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  endpoint  WebhookEndpoint    @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  execution WorkflowExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@index([endpointId])
  @@index([createdAt])
  @@map("webhook_logs")
}

/// A user-saved custom workflow template persisted to the database.
/// Created via POST /templates from a published workflow version.
model WorkflowCustomTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  slackTeamId     String   @map("slack_team_id")
  name            String
  description     String?
  graph           Json     @db.JsonB
  nodeCount       Int      @default(0) @map("node_count")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([slackTeamId])
  @@map("workflow_custom_templates")
}

/// Reusable training content stored in a shared library.
model ContentLibraryItem {
  id               String           @id @default(uuid()) @db.Uuid
  slackTeamId      String           @map("slack_team_id")
  type             TrainingItemType
  title            String
  content          String?          @db.Text
  metadata         Json?            @db.JsonB
  estimatedMinutes Int?             @map("estimated_minutes")
  categoryTags     String[]         @default([]) @map("category_tags")
  usageCount       Int              @default(0) @map("usage_count")
  createdByUserId  String           @map("created_by_user_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  trainingItems TrainingItem[]

  @@index([slackTeamId])
  @@index([type])
  @@map("content_library_items")
}

// ---------------------------------------------------------------------------
// Billing Models
// ---------------------------------------------------------------------------

/// Client workspace billing configuration.
/// One billing profile per workspace. Controls credit allowance,
/// overage rates, and payment method references.
model BillingProfile {
  id            String        @id @default(uuid()) @db.Uuid
  slackTeamId   String        @unique @map("slack_team_id")
  status        BillingStatus @default(PENDING)
  billingExempt Boolean       @default(false) @map("billing_exempt")

  // Credit configuration
  monthlyAllowance   Int     @map("monthly_allowance")
  creditBalance      Int     @default(0) @map("credit_balance")
  maxRolloverCredits Int     @map("max_rollover_credits")
  overageRateUsd     Decimal @map("overage_rate_usd") // USD per credit

  // Billing cycle
  billingCycleDay Int       @map("billing_cycle_day") // 1-31
  lastResetAt     DateTime? @map("last_reset_at")

  // Contact info
  billingContactUserId String? @map("billing_contact_user_id") // Slack user ID
  billingEmail         String? @map("billing_email")

  // Stripe references
  stripeCustomerId      String? @unique @map("stripe_customer_id")
  stripePaymentMethodId String? @map("stripe_payment_method_id")

  // Multi-tenant SaaS licensing fields (Feature 35)
  subscriptionTier     String    @default("starter") @map("subscription_tier")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  nextResetAt          DateTime? @map("next_reset_at")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  transactions CreditTransaction[]
  magicLinks   MagicLink[]

  @@index([status])
  @@index([billingCycleDay])
  @@map("billing_profiles")
}

/// Immutable credit transaction ledger.
/// Append-only: no UPDATE or DELETE. No updatedAt field.
/// Every credit movement is recorded here for audit trail.
model CreditTransaction {
  id               String                @id @default(uuid()) @db.Uuid
  billingProfileId String                @map("billing_profile_id") @db.Uuid
  type             CreditTransactionType
  amount           Int // Positive = addition, negative = deduction
  balanceAfter     Int                   @map("balance_after")
  referenceId      String?               @map("reference_id") // Job ID or Stripe charge ID
  description      String                @db.Text
  metadata         Json?                 @db.JsonB // Extra context (admin ID, rate snapshot, etc.)
  clientId         String?               @map("client_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")

  // Relations
  billingProfile BillingProfile @relation(fields: [billingProfileId], references: [id], onDelete: Cascade)
  client         ManagedClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([billingProfileId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceId])
  @@index([clientId])
  @@map("credit_transactions")
}

/// Singleton cache configuration for TTL and feature toggles.
/// Shared across all workspaces. Extended by Feature 17 (BuiltWith) and Feature 22 (Apollo).
model CacheConfig {
  id                   String   @id @default(uuid()) @db.Uuid
  enabled              Boolean  @default(true)
  ttlDays              Int      @default(60) @map("ttl_days")
  apolloSearchTtlDays  Int      @default(14) @map("apollo_search_ttl_days")
  apolloContactTtlDays Int      @default(30) @map("apollo_contact_ttl_days")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("cache_config")
}

/// Cached Apollo people search result for a domain + filter combination (FR-001).
/// Shared across all workspaces — search results are not tenant-specific.
model ApolloSearchCache {
  id               String   @id @default(uuid()) @db.Uuid
  normalizedDomain String   @map("normalized_domain")
  filterHash       String   @map("filter_hash")
  contacts         Json     @db.JsonB
  resultCount      Int      @map("result_count")
  filterSnapshot   Json     @map("filter_snapshot") @db.JsonB
  hitCount         Int      @default(0) @map("hit_count")
  searchedAt       DateTime @default(now()) @map("searched_at")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([normalizedDomain, filterHash])
  @@index([expiresAt])
  @@index([searchedAt])
  @@map("apollo_search_cache")
}

/// Cached Apollo bulk enrichment result for an individual contact (FR-008).
/// Shared across all workspaces — contact professional data is not tenant-specific.
model ApolloContactCache {
  id             String   @id @default(uuid()) @db.Uuid
  apolloPersonId String   @unique @map("apollo_person_id")
  fullName       String?  @map("full_name")
  firstName      String?  @map("first_name")
  lastName       String?  @map("last_name")
  email          String?
  jobTitle       String?  @map("job_title")
  seniorityLevel String?  @map("seniority_level")
  linkedinUrl    String?  @map("linkedin_url")
  timezoneUtc    String?  @map("timezone_utc")
  timezoneLabel  String?  @map("timezone_label")
  hasPhoneData   Boolean  @default(false) @map("has_phone_data")
  directPhone    String?  @map("direct_phone")
  businessPhone  String?  @map("business_phone")
  apolloMetadata Json?    @map("apollo_metadata") @db.JsonB
  hitCount       Int      @default(0) @map("hit_count")
  enrichedAt     DateTime @default(now()) @map("enriched_at")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@index([enrichedAt])
  @@map("apollo_contact_cache")
}

/// Global credit rate configuration.
/// Defines base credit cost per operation type and global markup percentage.
/// Exactly one active configuration at any time.
model CreditRateConfig {
  id                        String   @id @default(uuid()) @db.Uuid
  builtWithCtuLookupCost    Int      @map("builtwith_ctu_lookup_cost")
  builtWithDomainLookupCost Int      @map("builtwith_domain_lookup_cost")
  apolloPeopleSearchCost    Int      @map("apollo_people_search_cost")
  apolloBulkEnrichCost      Int      @map("apollo_bulk_enrich_cost")
  markupPercent             Int      @map("markup_percent") // e.g., 25 for 25%
  isActive                  Boolean  @default(true) @map("is_active")
  updatedByAdminId          String?  @map("updated_by_admin_id") @db.Uuid
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("credit_rate_configs")
}

/// Secure magic link tokens for payment onboarding.
/// Each token is single-use and expires after 24 hours.
model MagicLink {
  id               String    @id @default(uuid()) @db.Uuid
  billingProfileId String    @map("billing_profile_id") @db.Uuid
  token            String    @unique
  expiresAt        DateTime  @map("expires_at")
  usedAt           DateTime? @map("used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  // Relations
  billingProfile BillingProfile @relation(fields: [billingProfileId], references: [id], onDelete: Cascade)

  @@index([billingProfileId])
  @@index([token])
  @@index([expiresAt])
  @@map("magic_links")
}

// ---------------------------------------------------------------------------
// HubSpot OAuth Integration Models (Feature 14)
// ---------------------------------------------------------------------------

enum HubSpotConnectionStatus {
  ACTIVE
  DISCONNECTED
  TOKEN_EXPIRED
  ERROR
}

enum HubSpotImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum HubSpotSyncType {
  CONTACT_IMPORT
  ACTIVITY_PUSH
  ACTIVITY_PULL
  WEBHOOK_EVENT
}

/// A client's OAuth connection to their HubSpot portal. One-to-one with ManagedClient.
model HubSpotConnection {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @unique @map("client_id") @db.Uuid

  // OAuth tokens (encrypted at application layer via tokenEncryption.ts)
  accessToken    String   @map("access_token") @db.Text
  refreshToken   String   @map("refresh_token") @db.Text
  tokenExpiresAt DateTime @map("token_expires_at")

  // HubSpot portal info
  hubspotPortalId   String   @map("hubspot_portal_id")
  hubspotPortalName String?  @map("hubspot_portal_name")
  grantedScopes     String[] @map("granted_scopes")

  // Connection lifecycle
  status          HubSpotConnectionStatus @default(ACTIVE)
  connectedBy     String                  @map("connected_by")
  connectedAt     DateTime                @default(now()) @map("connected_at")
  disconnectedAt  DateTime?               @map("disconnected_at")
  lastRefreshedAt DateTime?               @map("last_refreshed_at")

  // Custom properties provisioned flag
  propertiesCreated Boolean @default(false) @map("properties_created")

  // Sync tracking
  lastSyncAt            DateTime? @map("last_sync_at")
  totalContactsSynced   Int       @default(0) @map("total_contacts_synced")
  totalActivitiesLogged Int       @default(0) @map("total_activities_logged")
  totalSyncFailures     Int       @default(0) @map("total_sync_failures")

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  client             ManagedClient              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  importJobs         HubSpotImportJob[]
  contactMappings    HubSpotContactMapping[]
  engagementMappings HubSpotEngagementMapping[]
  syncLogs           HubSpotSyncLog[]
  crmConnection      CrmConnection?

  @@index([status])
  @@map("hubspot_connections")
}

/// Tracks each contact import operation from CSV/XLSX to HubSpot.
model HubSpotImportJob {
  id           String @id @default(uuid()) @db.Uuid
  connectionId String @map("connection_id") @db.Uuid

  // Source file
  sourceFileName  String  @map("source_file_name")
  sourceFileUrl   String? @map("source_file_url") @db.Text
  sourceRowCount  Int     @map("source_row_count")
  enrichmentJobId String? @map("enrichment_job_id") @db.Uuid

  // Import naming
  clientName   String @map("client_name")
  campaignName String @map("campaign_name")
  listName     String @map("list_name")

  // HubSpot results
  hubspotListId  String? @map("hubspot_list_id")
  hubspotListUrl String? @map("hubspot_list_url") @db.Text

  // Column mapping used
  columnMapping Json @map("column_mapping")

  // Counts
  contactsCreated Int @default(0) @map("contacts_created")
  contactsUpdated Int @default(0) @map("contacts_updated")
  contactsFailed  Int @default(0) @map("contacts_failed")
  contactsTotal   Int @default(0) @map("contacts_total")

  // Job tracking
  status       HubSpotImportStatus @default(PENDING)
  errorMessage String?             @map("error_message") @db.Text
  startedAt    DateTime?           @map("started_at")
  completedAt  DateTime?           @map("completed_at")

  // Slack context
  slackChannelId String  @map("slack_channel_id")
  slackThreadTs  String? @map("slack_thread_ts")
  slackUserId    String  @map("slack_user_id")

  // BullMQ reference
  bullmqJobId String? @map("bullmq_job_id")

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  connection HubSpotConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([status])
  @@index([slackChannelId])
  @@map("hubspot_import_jobs")
}

/// Links internal contacts (by email) to HubSpot contact IDs for deduplication and activity association.
model HubSpotContactMapping {
  id           String @id @default(uuid()) @db.Uuid
  connectionId String @map("connection_id") @db.Uuid

  // Contact identity
  email            String
  hubspotContactId String  @map("hubspot_contact_id")
  hubspotCompanyId String? @map("hubspot_company_id")

  // Sync metadata
  lastSyncedAt DateTime @default(now()) @map("last_synced_at")
  importJobId  String?  @map("import_job_id") @db.Uuid

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  connection HubSpotConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, email])
  @@index([hubspotContactId])
  @@map("hubspot_contact_mappings")
}

/// Tracks engagement records pushed to HubSpot to prevent duplicate activity logging.
model HubSpotEngagementMapping {
  id           String @id @default(uuid()) @db.Uuid
  connectionId String @map("connection_id") @db.Uuid

  // Internal event reference
  eventType   String @map("event_type")
  eventId     String @map("event_id")
  eventSource String @map("event_source")

  // HubSpot engagement
  hubspotEngagementId String @map("hubspot_engagement_id")
  hubspotContactId    String @map("hubspot_contact_id")

  // Audit
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  connection HubSpotConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, eventType, eventId, eventSource])
  @@index([hubspotContactId])
  @@map("hubspot_engagement_mappings")
}

/// Records each sync operation for history, debugging, and statistics.
model HubSpotSyncLog {
  id           String @id @default(uuid()) @db.Uuid
  connectionId String @map("connection_id") @db.Uuid

  // Sync details
  syncType  HubSpotSyncType
  direction String          @default("push")

  // Results
  recordsProcessed Int @default(0) @map("records_processed")
  recordsCreated   Int @default(0) @map("records_created")
  recordsUpdated   Int @default(0) @map("records_updated")
  recordsFailed    Int @default(0) @map("records_failed")

  // Metadata
  durationMs   Int?    @map("duration_ms")
  errorMessage String? @map("error_message") @db.Text
  metadata     Json?

  // Audit
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  connection HubSpotConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([syncType])
  @@index([createdAt])
  @@map("hubspot_sync_logs")
}

// ---------------------------------------------------------------------------
// Domain Enrichment Cache Models (Feature 17)
// ---------------------------------------------------------------------------

/// Domain-keyed cache of BuiltWith enrichment results (FR-001).
/// Shared across all workspaces — BuiltWith data is public, not tenant-specific.
model DomainEnrichmentCache {
  id                String   @id @default(uuid()) @db.Uuid
  normalizedDomain  String   @unique @map("normalized_domain")
  builtwithResponse Json     @map("builtwith_response") @db.JsonB
  technologies      Json     @map("technologies") @db.JsonB
  vertical          String?
  trafficRank       Int?     @map("traffic_rank")
  techSpendTier     String?  @map("tech_spend_tier")
  techSpendScore    Int?     @map("tech_spend_score")
