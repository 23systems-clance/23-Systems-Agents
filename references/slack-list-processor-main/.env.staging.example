# =============================================================================
# Staging Environment Configuration
# =============================================================================
# This file is for the STAGING environment. Copy to .env.staging and fill in.
#
# ENVIRONMENT-SPECIFIC values (different per environment):
#   - Slack tokens (staging Slack app)
#   - DATABASE_URL (staging RDS endpoint)
#   - REDIS_URL (staging ElastiCache endpoint)
#   - S3 bucket/endpoint (staging bucket)
#   - WEBHOOK_BASE_URL (staging ALB URL)
#
# SHARED values (same as production):
#   - All third-party API keys (BuiltWith, Apollo, Anthropic, etc.)
#   - Cost tracking rates
#   - HubSpot OAuth credentials
# =============================================================================

# --- ENVIRONMENT-SPECIFIC: Staging Slack App ---
SLACK_BOT_TOKEN=xoxb-your-staging-bot-token
SLACK_APP_TOKEN=xapp-your-staging-app-token
SLACK_SIGNING_SECRET=your-staging-signing-secret
SLACK_CLIENT_ID=your-staging-client-id
SLACK_CLIENT_SECRET=your-staging-client-secret
SLACK_STATE_SECRET=your-staging-state-secret

# --- ENVIRONMENT-SPECIFIC: Staging Database ---
DATABASE_URL=postgresql://listprocessor:password@staging-rds-endpoint:5432/list_processor
DB_PASSWORD=generate-a-unique-staging-password-min-16-chars

# --- ENVIRONMENT-SPECIFIC: Staging Redis ---
REDIS_URL=rediss://staging-redis-endpoint:6379

# --- ENVIRONMENT-SPECIFIC: Staging S3 ---
S3_BUCKET=staging-slack-list-processor-files
S3_REGION=us-east-1

# --- SHARED: Third-Party API Keys (same as production) ---
BUILTWITH_API_KEY=your-builtwith-api-key
APOLLO_API_KEY=your-apollo-api-key
APOLLO_WEBHOOK_SECRET=your-webhook-shared-secret
ANTHROPIC_API_KEY=your-anthropic-api-key
WIZA_API_KEY=your-wiza-bearer-token
AI_ARK_API_KEY=your-aiark-x-token
FINDYMAIL_API_KEY=your-findymail-api-key
DNCSCRUB_API_KEY=your-dncscrub-api-key

# --- SHARED: REST API Authentication ---
API_KEY=your-internal-api-key
SESSION_SECRET=generate-a-unique-staging-session-secret
TOKEN_ENCRYPTION_KEY=generate-a-unique-staging-encryption-key

# --- SHARED: Cost Tracking ---
BUILTWITH_COST_PER_CREDIT=0.05
APOLLO_COST_PER_CREDIT=0.05
AI_COST_PER_1K_INPUT_TOKENS=0.0008
AI_COST_PER_1K_OUTPUT_TOKENS=0.004

# --- SHARED: HubSpot OAuth ---
HUBSPOT_OAUTH_CLIENT_ID=your-hubspot-oauth-client-id
HUBSPOT_OAUTH_CLIENT_SECRET=your-hubspot-oauth-client-secret
HUBSPOT_OAUTH_REDIRECT_URI=https://your-staging-domain.com/api/hubspot/oauth/callback

# --- ENVIRONMENT-SPECIFIC: Application ---
NODE_ENV=production
LOG_LEVEL=info
HTTP_PORT=3000
WEBHOOK_BASE_URL=http://staging-alb-dns-name

# --- SHARED: Platform Owner ---
PLATFORM_OWNER_TEAM_ID=your-slack-team-id

# --- ENVIRONMENT-SPECIFIC: CloudFormation Deploy Parameters ---
# These are used by deploy.sh when deploying the staging CF stack
CORS_ALLOWED_ORIGINS=https://staging-cloudfront-url
ACM_CERTIFICATE_ARN=
OAUTH_REDIRECT_URI=
