# BuildWith MCP Server Configuration

# Required - Get your API key at https://api.builtwith.com/
BUILTWITH_API_KEY=your_api_key_here

# Rate Limiting
MCP_RATE_LIMIT_RPS=10           # Max requests per second
MCP_MAX_CONCURRENT=8            # Max concurrent requests

# Caching
MCP_CACHE_ENABLED=true          # Enable/disable caching
MCP_CACHE_SIZE=1000             # Max number of cache entries
MCP_CACHE_TTL=3600              # Cache TTL in seconds (1 hour)

# Retry Configuration
MCP_RETRY_MAX=3                 # Max retry attempts
MCP_RETRY_INITIAL_DELAY=1000    # Initial delay before retry (ms)
MCP_RETRY_MAX_DELAY=60000       # Maximum delay cap (ms)
MCP_RETRY_BACKOFF_MULTIPLIER=2  # Exponential backoff multiplier
MCP_RETRY_JITTER_MAX=1000       # Max random jitter (ms)

# Logging
MCP_LOG_LEVEL=info              # debug | info | warn | error
MCP_LOG_PRETTY=false            # Pretty print logs (set to true for development)

# Metrics
MCP_METRICS_ENABLED=true        # Enable metrics collection
